# AI API Keys - Copy to .env and fill in your keys
# See API_KEYS_SETUP.md for detailed instructions on obtaining these keys

# OpenAI API (GPT-4o, GPT-4 Turbo) - substitute for GitHub Copilot
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude API (Sonnet 4.5) - complex logic
# Get from: https://claude.ai/account/api-keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API (2.5 Pro) - validation with 1M context
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepInfra API (Qwen 2.5 Coder) - batch processing
# Get from: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Token (optional - doesn't give Copilot API access!)
# Get from: https://github.com/settings/tokens
# Note: GitHub Copilot has NO public API - use OpenAI API instead
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
